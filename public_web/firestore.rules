rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isLoggedIn() && request.auth.uid == userId;
    }

    function isSystemAdmin() {
      return isLoggedIn()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // ── Quyền Admin Hệ thống ────────────────────────────────────────────────
    match /roles/{userId} {
      allow read: if isLoggedIn() && (request.auth.uid == userId || isSystemAdmin());
      allow write: if isSystemAdmin();
    }

    // ── Dữ liệu nghiệp vụ của Chủ trọ (App Flutter ghi vào đây) ───────────
    // Chủ trọ (đã đăng nhập, đúng uid) được đọc/ghi toàn bộ dữ liệu của mình.
    // Admin hệ thống được đọc/ghi tất cả để kiểm duyệt.
    match /users/{userId}/maintenance/{ticketId} {
      allow read: if true;
      allow create: if request.resource.data.keys().size() <= 20;
      allow update, delete: if isOwner(userId) || isSystemAdmin();
    }

    match /users/{userId}/{document=**} {
      allow read: if true; // website public có thể đọc phòng trống
      allow write: if isOwner(userId) || isSystemAdmin();
    }

    // ── Phòng trống public: cho phép đọc qua collectionGroup ───────────────
    match /{path=**}/rooms/{roomId} {
      allow read: if true;
      allow write: if isSystemAdmin();
    }

    // ── Yêu cầu liên hệ & sửa chữa từ website ─────────────────────────────
    match /inquiries/{landlordId}/requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.keys().size() <= 20;
      allow update, delete: if isLoggedIn() && (request.auth.uid == landlordId || isSystemAdmin());
    }

    // ── Fallback: các collection khác chỉ Admin hoặc chủ tài khoản ─────────
    match /{document=**} {
      allow read, write: if isSystemAdmin();
    }
  }
}
